{
  "$schema": "https://raw.githubusercontent.com/Exit-9B/MCM-Helper/main/docs/config.schema.json",
  "modName": "HelloWorld",
  "displayName": "Hello World",
  "minMcmVersion": 13,
  "content": [
    {
      "type": "header",
      "text": "General"
    },
    {
      "id": "iMessageDelay:General",
      "text": "Message delay",
      "help": "Seconds between headset connection notifications.",
      "type": "slider",
      "valueOptions": {
        "min": 10,
        "max": 600,
        "step": 10,
        "formatString": "{0} seconds",
        "sourceType": "ModSettingInt"
      }
    },
    {
      "id": "sMessageText:General",
      "text": "Message Text (VR fallback)",
      "help": "Current custom message. If the editable Message Text row is missing, select this row for INI editing instructions.",
      "type": "text",
      "valueOptions": {
        "sourceType": "ModSettingString"
      },
      "action": {
        "type": "CallFunction",
        "function": "ShowMessageTextHelp"
      }
    },
    {
      "id": "sMessageText:General",
      "text": "Message Text",
      "help": "Custom notification text for headcanon, notes or reminders. When blank the default headset connection messages display.",
      "type": "input",
      "valueOptions": {
        "sourceType": "ModSettingString"
      }
    }
  ]
}
