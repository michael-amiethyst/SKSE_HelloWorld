{
  "$schema": "https://raw.githubusercontent.com/Exit-9B/MCM-Helper/main/docs/config.schema.json",
  "modName": "HelloWorld",
  "displayName": "Hello World",
  "minMcmVersion": 13,
  "cursorFillMode": "topToBottom",
  "content": [
    {
      "type": "header",
      "text": "General"
    },
    {
      "id": "iMessageDelay:General",
      "text": "Message delay",
      "help": "Seconds between headset connection notifications.",
      "type": "slider",
      "valueOptions": {
        "min": 10,
        "max": 600,
        "step": 10,
        "formatString": "{0} seconds",
        "sourceType": "PropertyValueInt",
        "scriptName": "HelloWorldMCM",
        "propertyName": "MenuMessageDelay",
        "defaultValue": 180
      }
    },
    {
      "id": "sMessageText:General",
      "text": "Message Text",
      "help": "Custom notification text for headcanon, notes or reminders. When blank the default headset connection messages display.",
      "type": "input",
      "valueOptions": {
        "sourceType": "ModSettingString"
      }
    },
    {
      "type": "header",
      "text": "Message Text"
    }
  ]
}
