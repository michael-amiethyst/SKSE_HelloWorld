# The stamp is generated by RefreshMCMArtifact, never maintained by hand.
if(MODE STREQUAL "refresh")
    file(SHA256 "${SOURCE}" source_hash)
    file(SHA256 "${PEX}" pex_hash)
    file(WRITE "${STAMP}" "{\n  \"version\": \"${VERSION}\",\n  \"source_sha256\": \"${source_hash}\",\n  \"pex_sha256\": \"${pex_hash}\"\n}\n")
else()
    if(NOT EXISTS "${STAMP}" OR NOT EXISTS "${PEX}")
        message(FATAL_ERROR "Missing checked-in MCM artifact/stamp. Configure Papyrus and build RefreshMCMArtifact; see docs/contributing.md.")
    endif()
    file(READ "${STAMP}" stamp)
    string(JSON stamp_version GET "${stamp}" version)
    string(JSON stamp_source GET "${stamp}" source_sha256)
    string(JSON stamp_pex GET "${stamp}" pex_sha256)
    file(SHA256 "${SOURCE}" source_hash)
    file(SHA256 "${PEX}" pex_hash)
    if(NOT VERSION STREQUAL stamp_version OR NOT source_hash STREQUAL stamp_source OR NOT pex_hash STREQUAL stamp_pex)
        message(FATAL_ERROR "Stale MCM artifact: project version, generated source, or PEX differs from its stamp. Configure Papyrus and build RefreshMCMArtifact; see docs/contributing.md.")
    endif()
endif()
