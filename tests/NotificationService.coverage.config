<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*HelloWorldTests\.exe$</ModulePath>
      </Include>
    </ModulePaths>
    <Sources>
      <Include>
        <Source>.*[\\/]src[\\/]NotificationService\.(cpp|h)$</Source>
      </Include>
    </Sources>
    <EnableStaticNativeInstrumentation>True</EnableStaticNativeInstrumentation>
    <EnableDynamicNativeInstrumentation>False</EnableDynamicNativeInstrumentation>
    <EnableStaticManagedInstrumentation>False</EnableStaticManagedInstrumentation>
    <EnableDynamicManagedInstrumentation>False</EnableDynamicManagedInstrumentation>
  </CodeCoverage>
</Configuration>
