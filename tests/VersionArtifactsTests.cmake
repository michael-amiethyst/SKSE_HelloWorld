file(MAKE_DIRECTORY "${TEST_DIRECTORY}")
# Exercise an arbitrary future version without changing the real project version.
set(PROJECT_VERSION "9.8.7")
set(source "${TEST_DIRECTORY}/HelloWorldMCM.psc")
set(pex "${TEST_DIRECTORY}/HelloWorldMCM.pex")
set(stamp "${TEST_DIRECTORY}/artifact.json")
set(checker "${SOURCE_ROOT}/build-tools/CheckPapyrusArtifact.cmake")
file(READ "${SOURCE_ROOT}/mod/MCM/Config/HelloWorld/config.json" menu_json)
string(JSON fill_mode GET "${menu_json}" cursorFillMode)
if(NOT fill_mode STREQUAL "topToBottom")
    message(FATAL_ERROR "Message heading and value must appear on successive rows, not adjacent columns")
endif()
string(JSON row_count LENGTH "${menu_json}" content)
math(EXPR last_row "${row_count} - 1")
set(display_bound FALSE)
set(delay_bound FALSE)
foreach(index RANGE 0 ${last_row})
    string(JSON row_type GET "${menu_json}" content ${index} type)
    if(row_type STREQUAL "text")
        string(JSON property GET "${menu_json}" content ${index} valueOptions propertyName)
        string(JSON script GET "${menu_json}" content ${index} valueOptions scriptName)
        if(property STREQUAL "MenuMessageText" AND script STREQUAL "HelloWorldMCM")
            set(display_bound TRUE)
            string(JSON label ERROR_VARIABLE label_error GET "${menu_json}" content ${index} text)
            if(NOT label_error AND NOT label STREQUAL "")
                message(FATAL_ERROR "Message value must have no competing label on its row")
            endif()
            math(EXPR heading_index "${index} - 1")
            string(JSON heading_type GET "${menu_json}" content ${heading_index} type)
            string(JSON heading_text GET "${menu_json}" content ${heading_index} text)
            if(NOT heading_type STREQUAL "header" OR NOT heading_text STREQUAL "Message Text")
                message(FATAL_ERROR "Message value must immediately follow the Message Text heading")
            endif()
        endif()
    elseif(row_type STREQUAL "slider")
        string(JSON property GET "${menu_json}" content ${index} valueOptions propertyName)
        string(JSON script GET "${menu_json}" content ${index} valueOptions scriptName)
        string(JSON source_type GET "${menu_json}" content ${index} valueOptions sourceType)
        string(JSON default_delay GET "${menu_json}" content ${index} valueOptions defaultValue)
        if(property STREQUAL "MenuMessageDelay" AND script STREQUAL "HelloWorldMCM"
           AND source_type STREQUAL "PropertyValueInt" AND default_delay EQUAL 180)
            set(delay_bound TRUE)
        endif()
    endif()
endforeach()
if(NOT display_bound)
    message(FATAL_ERROR "Menu text must bind to the refreshed script property, not the cached mod setting")
endif()
if(NOT delay_bound)
    message(FATAL_ERROR "Menu slider must bind to the refreshed delay property with the correct reset default")
endif()
configure_file("${SOURCE_ROOT}/build-tools/Version.h.in" "${TEST_DIRECTORY}/Version.h" @ONLY NEWLINE_STYLE LF)
configure_file("${SOURCE_ROOT}/scripts/Source/HelloWorldMCM.psc.in" "${source}" @ONLY NEWLINE_STYLE LF)
foreach(file IN ITEMS "${source}" "${TEST_DIRECTORY}/Version.h")
    file(READ "${file}" contents)
    if(NOT contents MATCHES "9\\.8\\.7" OR contents MATCHES "@PROJECT_VERSION@")
        message(FATAL_ERROR "Version was not propagated to ${file}")
    endif()
endforeach()
file(WRITE "${pex}" "test artifact")
execute_process(COMMAND "${CMAKE_COMMAND}" -DMODE=refresh "-DVERSION=${PROJECT_VERSION}"
    "-DSOURCE=${source}" "-DPEX=${pex}" "-DSTAMP=${stamp}" -P "${checker}"
    RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Failed to create test stamp")
endif()

function(check_artifact version expect_success)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DVERSION=${version}"
        "-DSOURCE=${source}" "-DPEX=${pex}" "-DSTAMP=${stamp}" -P "${checker}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(expect_success AND NOT result EQUAL 0)
        message(FATAL_ERROR "Valid artifact rejected: ${error}")
    elseif(NOT expect_success AND result EQUAL 0)
        message(FATAL_ERROR "Stale artifact was accepted")
    elseif(NOT expect_success AND NOT error MATCHES "Stale MCM artifact")
        message(FATAL_ERROR "Unexpected failure: ${error}")
    endif()
endfunction()
check_artifact("9.8.7" TRUE)
check_artifact("9.8.8" FALSE)
file(APPEND "${source}" "; source changed\n")
check_artifact("9.8.7" FALSE)
configure_file("${SOURCE_ROOT}/scripts/Source/HelloWorldMCM.psc.in" "${source}" @ONLY NEWLINE_STYLE LF)
file(APPEND "${pex}" "changed")
check_artifact("9.8.7" FALSE)
message(STATUS "Version propagation and stale version/source/PEX checks passed")
